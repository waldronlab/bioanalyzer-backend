[flake8]
# Maximum line length
max-line-length = 120

# Extend ignore list
# E203: whitespace before ':' (conflicts with black)
# W503: line break before binary operator (conflicts with black)
# E501: line too long (handled by max-line-length)
extend-ignore = E203, W503, E501

# Exclude patterns
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .env,
    build,
    dist,
    *.egg-info,
    .eggs,
    .pytest_cache,
    .mypy_cache,
    .coverage,
    htmlcov,
    .tox,
    .cache,
    node_modules,
    migrations

# Per-file ignores
per-file-ignores =
    __init__.py:F401
    tests/*:F401,F811

# Maximum complexity
max-complexity = 10

# Show source
show-source = True

# Statistics
statistics = False

# Count errors
count = False

