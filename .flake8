[flake8]
# Maximum line length
max-line-length = 120

# Extend ignore list
# E203: whitespace before ':' (conflicts with black)
# W503: line break before binary operator (conflicts with black)
# E501: line too long (handled by max-line-length)
# E402: module level import not at top of file (sometimes needed for conditional imports)
# F403: unable to detect undefined names from * imports (used in __init__.py)
# F541: f-string missing placeholders (sometimes used for consistency)
# C901: function too complex (warn but don't fail - complexity is acceptable in some cases)
extend-ignore = E203, W503, E501, E402, F403, F541, C901

# Exclude patterns
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .env,
    build,
    dist,
    *.egg-info,
    .eggs,
    .pytest_cache,
    .mypy_cache,
    .coverage,
    htmlcov,
    .tox,
    .cache,
    node_modules,
    migrations

# Per-file ignores
per-file-ignores =
    __init__.py:F401,F403
    tests/*:F401,F811,F841
    cli.py:F841,E722
    app/api/app.py:E402
    app/services/*:E402
    app/utils/*:E402
    app/models/unified_qa.py:F811
    app/api/routers/system.py:F841

# Maximum complexity
max-complexity = 10

# Show source
show-source = True

# Statistics
statistics = False

# Count errors
count = False

