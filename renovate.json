{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "BioAnalyzer Renovate config - stable + secure dependency automation",

  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":separatePatchReleases",
    ":timezone(UTC)"
  ],

  "timezone": "UTC",
  "schedule": ["before 10:00 on Monday"],

  "enabledManagers": [
    "pip_requirements",
    "dockerfile",
    "docker-compose",
    "github-actions",
    "custom.regex"
  ],

  "dependencyDashboardTitle": "🤖 Dependency Updates Dashboard",
  "dependencyDashboardFooter": "Review and merge PRs as needed.",

  "labels": ["dependencies"],
  "assignees": ["RonaldRonnie"],
  "reviewers": ["RonaldRonnie"],

  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,

  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",

  "stabilityDays": 3,
  "minimumReleaseAge": "3 days",

  "rangeStrategy": "auto",

  "packageRules": [
    {
      "description": "Group all Python dependencies",
      "matchManagers": ["pip_requirements"],
      "groupName": "🐍 Python dependencies",
      "stabilityDays": 3
    },

    {
      "description": "Vulnerability alerts - immediate and high priority",
      "isVulnerabilityAlert": true,
      "groupName": "🛡️ Security updates",
      "schedule": ["at any time"],
      "stabilityDays": 0,
      "prPriority": 10,
      "labels": ["security", "dependencies"]
    },

    {
      "description": "ML/AI dependencies - manual review",
      "matchPackageNames": [
        "torch",
        "torchvision",
        "torchaudio",
        "transformers",
        "google-generativeai",
        "litellm",
        "paper-qa"
      ],
      "groupName": "🧠 ML/AI dependencies",
      "stabilityDays": 7,
      "automerge": false,
      "labels": ["ml", "ai", "dependencies"]
    },

    {
      "description": "Patch updates for safe libs -> automerge",
      "matchManagers": ["pip_requirements"],
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": [
        "requests",
        "beautifulsoup4",
        "lxml",
        "python-dotenv",
        "psutil",
        "tqdm",
        "pytz",
        "PyYAML",
        "click"
      ],
      "automerge": true,
      "stabilityDays": 1,
      "labels": ["automerge"]
    },

    {
      "description": "Minor updates for safe utility libs -> automerge",
      "matchManagers": ["pip_requirements"],
      "matchUpdateTypes": ["minor"],
      "matchPackageNames": [
        "python-dotenv",
        "psutil",
        "tqdm",
        "pytz",
        "PyYAML",
        "click",
        "openpyxl",
        "xlrd"
      ],
      "automerge": true,
      "stabilityDays": 2,
      "labels": ["automerge"]
    },

    {
      "description": "Major updates always manual",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "stabilityDays": 14,
      "labels": ["major-update", "breaking-change"]
    },

    {
      "description": "Docker base images",
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "🐳 Docker images",
      "stabilityDays": 7,
      "labels": ["docker", "dependencies"]
    },

    {
      "description": "GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "⚙️ GitHub Actions",
      "stabilityDays": 2,
      "labels": ["github-actions", "ci/cd"]
    }
  ],

  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "assignees": ["RonaldRonnie"],
    "reviewers": ["RonaldRonnie"],
    "prPriority": 10,
    "stabilityDays": 0
  },

  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["on the first day of the month"],
    "labels": ["maintenance", "dependencies"]
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "Update python base image version in Dockerfile",
      "fileMatch": ["^Dockerfile$"],
      "matchStrings": ["FROM python:(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "python",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ]
}
