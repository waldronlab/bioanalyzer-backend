flowchart TD
    U["User / Curator"]
    CLI["BioAnalyzer CLI (scripts/cli.py)"]
    FILES["Input files: txt, csv, xls, xlsx"]
    API["FastAPI backend (app/api)"]
    ORCH["Agent orchestrator"]
    RET["Data retrieval: PubMed + web scraper"]
    RAG["RAG + embeddings + vector store"]
    LLM["LLM inference"]
    VAL["Field extraction and validation (6 BugSigDB fields)"]
    OUT["Output formatter: table, json, csv, xml"]
    RES["Results output: terminal + files"]
    DOCKER["Docker Compose services"]
    ENV[".env + settings"]
    HEALTH["Health and status checks"]

    U -->|"build / start / status / stop"| CLI
    U -->|"analyze pmids or file"| CLI
    U -->|"analyze-url / retrieve / qa"| CLI

    CLI --> ENV
    CLI --> DOCKER
    DOCKER --> API
    CLI --> HEALTH
    HEALTH --> API

    CLI -->|"submit request"| API
    CLI -->|"read PMIDs"| FILES
    FILES --> CLI

    API --> ORCH
    ORCH --> RET
    RET --> ORCH

    ORCH --> RAG
    RAG --> LLM
    LLM --> RAG
    RAG --> ORCH

    ORCH --> VAL
    VAL --> API

    API --> OUT
    OUT --> CLI
    CLI --> RES
    RES --> U
