[bandit]
# Bandit configuration file
# See: https://bandit.readthedocs.io/en/latest/config.html

# Exclude paths
exclude_dirs = tests,scripts,venv,.venv,env,.env,build,dist,*.egg-info,.eggs,.pytest_cache,.mypy_cache,.coverage,htmlcov,.tox,.cache,node_modules,migrations

# Skip specific test IDs (if needed)
# skip = B101,B601

# Severity levels: low, medium, high
# Confidence levels: low, medium, high

# Only report issues with high severity and confidence
severity_level = medium
confidence_level = medium

